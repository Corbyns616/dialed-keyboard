<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DialedKeyboard</AssemblyName>
    <Version>1.1.1</Version>
    <Product>Dialed Keyboard</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release only: uiAccess needs the signed Program Files install (installer/trust-and-sign.ps1). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespaces from clashing with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\words_en.txt" LogicalName="DialedKeyboard.words_en.txt" />
    <!-- Key click sounds: NK Cream from Mechvibes (MIT), shared with ASMR Typer. -->
    <None Include="Sounds\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Sticker background removal: U²-Net "u2netp" (Apache 2.0), converted to ONNX by rembg (MIT). -->
    <None Include="Models\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
