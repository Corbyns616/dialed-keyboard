<Window x:Class="DialedKeyboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DialedKeyboard Settings" Width="620" Height="760" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Opacity" Width="110" VerticalAlignment="Center"/>
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Theme" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeBox" Width="140" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="Light"/>
                </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <CheckBox x:Name="SoundsBox" Content="Key sounds" Width="110" VerticalAlignment="Center"/>
                <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ToolTip="Key sound volume" IsEnabled="{Binding IsChecked, ElementName=SoundsBox}"/>
            </DockPanel>
            <CheckBox x:Name="AutoCapBox" Content="Capitalize the start of sentences" Margin="0,4"/>
            <CheckBox x:Name="DoubleSpaceBox" Content="Double space types a period" Margin="0,4"/>
            <CheckBox x:Name="SmartPunctBox" Content="Punctuation removes the space before it (word . → word. )" Margin="0,4"/>
            <CheckBox x:Name="AutoExpandBox" Content="Expand shortcuts automatically when I press Space" Margin="0,4"/>
            <CheckBox x:Name="SuggestPhrasesBox" Content="Suggest whole phrases I type often (otherwise one word at a time)" Margin="0,4"/>
            <CheckBox x:Name="ProtectPasswordsBox" Margin="0,4">
                <TextBlock TextWrapping="Wrap"
                           Text="Protect passwords: in password boxes, learn nothing, hide suggestions and don't change what I type. A single word typed on its own and sent with Enter isn't learned either."/>
            </CheckBox>
            <DockPanel Margin="0,4,0,4">
                <TextBlock Text="Swipe typing" Width="110" VerticalAlignment="Center"/>
                <ComboBox x:Name="SwipeModeBox" HorizontalAlignment="Left">
                    <ComboBoxItem Tag="Off" Content="Off"/>
                    <ComboBoxItem Tag="Hold" Content="Hold the button down and drag across the letters"/>
                    <ComboBoxItem Tag="NoHold" Content="No-hold: tap Swipe, click the first letter, move, click the last letter"/>
                </ComboBox>
            </DockPanel>
            <CheckBox x:Name="HoldToForgetBox" Margin="0,4">
                <TextBlock TextWrapping="Wrap"
                           Text="Hold a suggestion to forget that word: it turns red, then tap it again and it's never suggested again (until you type it yourself)."/>
            </CheckBox>
            <CheckBox x:Name="HoverBox" Margin="0,4">
                <TextBlock TextWrapping="Wrap"
                           Text="Hover to press: rest the pointer on a key and it presses by itself. To press the same key again, move off it and back."/>
            </CheckBox>
            <DockPanel Margin="24,0,0,8" IsEnabled="{Binding IsChecked, ElementName=HoverBox}">
                <TextBlock Text="Hover time" Width="86" VerticalAlignment="Center"/>
                <TextBlock x:Name="HoverTimeText" DockPanel.Dock="Right" Width="70" VerticalAlignment="Center" TextAlignment="Right"/>
                <Slider x:Name="HoverTimeSlider" Minimum="0.3" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ToolTip="How long to rest on a key before it presses" ValueChanged="HoverTimeSlider_ValueChanged"/>
            </DockPanel>
            <CheckBox x:Name="StickersBox" Margin="0,4">
                <TextBlock TextWrapping="Wrap"
                           Text="Stickers key: search the internet for pictures (openly licensed ones, through Openverse) and turn them into stickers. Turn this off and the keyboard never goes online."/>
            </CheckBox>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,12,0,12">
            <TabItem Header="Text shortcuts">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="Gray"
                               Text="Type the shortcut and it appears as the first (green) suggestion. Press + Add shortcut, type the shortcut, then click the box next to it and type what it expands to."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+  Add shortcut" FontSize="16" FontWeight="SemiBold" Padding="18,8" Margin="0,0,8,0"
                                ToolTip="Adds a new row and puts the cursor in it" Click="AddShortcut_Click"/>
                        <Button Content="−  Remove selected" FontSize="16" Padding="18,8"
                                ToolTip="Removes the selected row" Click="RemoveShortcut_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ExpansionGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Shortcut" Binding="{Binding Abbreviation}" Width="120"/>
                            <DataGridTextColumn Header="Expands to" Binding="{Binding Expansion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Memory">
                <DockPanel Margin="6">
                    <TextBlock x:Name="LearnedInfo" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="PauseLearningBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                              Content="Pause learning (nothing new is remembered)"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="LearnedSearch" TextChanged="LearnedSearch_TextChanged"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Forget selected" Padding="10,4" Margin="0,0,8,0" Click="ForgetSelected_Click"/>
                        <Button Content="Forget everything…" Padding="10,4" Margin="0,0,8,0" Click="ForgetAll_Click"/>
                        <Button Content="Open data folder" Padding="10,4" Click="OpenFolder_Click"/>
                    </StackPanel>
                    <ListView x:Name="LearnedList" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Word" Width="220" DisplayMemberBinding="{Binding Word}"/>
                                <GridViewColumn Header="Times typed" Width="100" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="Usually followed by" Width="200" DisplayMemberBinding="{Binding Next}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
